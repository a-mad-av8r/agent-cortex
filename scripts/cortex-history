#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/_cortex_lib.sh
source "$SCRIPT_DIR/_cortex_lib.sh"
require_db

project="$(sql_escape "$CORTEX_PROJECT")"
sqlite3 -header -column "$CORTEX_DB" "
SELECT 'decision' AS type, created_at, agent_name, summary AS text FROM decisions WHERE project='$project'
UNION ALL
SELECT 'lesson', created_at, agent_name, summary FROM lessons WHERE project='$project'
UNION ALL
SELECT 'message', created_at, agent_name, body FROM messages WHERE project='$project'
UNION ALL
SELECT 'knowledge', created_at, agent_name, body FROM knowledge WHERE project='$project'
ORDER BY created_at DESC
LIMIT 50;
"
