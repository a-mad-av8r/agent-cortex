#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/_cortex_lib.sh
source "$SCRIPT_DIR/_cortex_lib.sh"
require_db

agent_name="${1:-$CORTEX_AGENT}"
safe_agent="$(sql_escape "$agent_name")"
safe_project="$(sql_escape "$CORTEX_PROJECT")"
ensure_agent "$agent_name"
sqlite3 "$CORTEX_DB" "INSERT INTO agent_sessions(agent_name, project, summary) VALUES ('$safe_agent', '$safe_project', 'bootstrap');"

echo "# Agent Cortex boot context for $agent_name"
echo
echo "Project: $CORTEX_PROJECT"
echo "Database: $CORTEX_DB"
echo
echo "## Recent Decisions"
sqlite3 -line "$CORTEX_DB" "SELECT created_at, summary FROM decisions WHERE project='$safe_project' ORDER BY id DESC LIMIT 5;"
echo
echo "## Recent Lessons"
sqlite3 -line "$CORTEX_DB" "SELECT created_at, summary FROM lessons WHERE project='$safe_project' ORDER BY id DESC LIMIT 5;"
echo
echo "## Recent Knowledge"
sqlite3 -line "$CORTEX_DB" "SELECT created_at, title FROM knowledge WHERE project='$safe_project' ORDER BY id DESC LIMIT 5;"
